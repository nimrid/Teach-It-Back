# ==========================================
# Teach It Back - Production & Testnet Config
# ==========================================

# Server Port (Render/Fly/Railway set this automatically)
PORT=3001
NODE_ENV=production

# Nimiq Testnet Configuration (Default)
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com/
TREASURY_ADDRESS=NQ80 TEAC H1TB ACK7 REAS URYT ESTN ETVA LADA

# Admin Secret Key (Used to authorize POST /api/admin/close-round)
ADMIN_API_KEY=tib-testnet-admin-secret

# Supabase PostgreSQL Configuration (For Render Free Tier diskless persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional: Set if frontend is hosted separately from backend
# VITE_API_URL=https://api.yourdomain.com
